# Cloudflare Pages headers config (Netlify-compatible syntax).
# Cache the data file briefly at the edge — when the workflow pushes a new
# version, the URL is the same so we rely on a short TTL + revalidation.
/data.json
  Cache-Control: public, max-age=120, s-maxage=120, stale-while-revalidate=600

/valuation.json
  Cache-Control: public, max-age=120, s-maxage=120, stale-while-revalidate=600

# Static assets (the HTML shell) can be cached longer; HTML revalidates
# instantly via Pages' atomic deploys.
#
# ── Header keamanan (Paket 1 hardening) ──────────────────────────────────
# X-Frame-Options + frame-ancestors  : anti clickjacking (halaman tak bisa
#                                       di-embed di iframe situs lain).
# X-Content-Type-Options             : cegah MIME-sniffing.
# Referrer-Policy                    : jangan bocorkan URL penuh ke situs lain.
# Strict-Transport-Security (HSTS)   : paksa browser selalu pakai HTTPS 1 thn.
# Permissions-Policy                 : matikan API yang tak dipakai
#                                       (kamera/mic/lokasi) + opt-out Topics.
# Content-Security-Policy (CSP)      : pertahanan utama anti-XSS. script-src
#                                       dibatasi ke CDN tepercaya saja (Chart.js,
#                                       lightweight-charts, TradingView). Inline
#                                       script/style diizinkan karena situs ini
#                                       memang inline-heavy (133+ onclick),
#                                       tapi script dari domain asing diblokir.
#                                       object-src none + base-uri self =
#                                       tutup celah plugin & <base> hijack.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://*.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.tradingview.com https://*.mayar.id https://terminal-live.chamdani49.workers.dev https://valuation-uploader.chamdani49.workers.dev https://chamdani49-boop.github.io; frame-src 'self' https://*.tradingview.com https://*.mayar.id; form-action 'self' https://*.mayar.id; worker-src 'self' blob:
