# Cloudflare Pages headers config (Netlify-compatible syntax).
# Cache the data file briefly at the edge — when the workflow pushes a new
# version, the URL is the same so we rely on a short TTL + revalidation.
/data.json
  Cache-Control: public, max-age=120, s-maxage=120, stale-while-revalidate=600

/valuation.json
  Cache-Control: public, max-age=120, s-maxage=120, stale-while-revalidate=600

# ── HTML shells: NEVER cache without server revalidation. ──────────────
# Bug: default browser heuristic caching pernah bikin user tetap load
# JS/HTML LAMA walau sudah hard-refresh (Ctrl+Shift+R) berjam-jam setelah
# deploy baru. Fix: pakai `no-cache` (bukan `no-store`) supaya browser
# boleh simpan tapi HARUS revalidate via If-Modified-Since / ETag tiap
# request. 304 Not Modified → hemat bytes; 200 → dapat versi baru.
#
# PENTING: kita cover BOTH the clean-URL routes yang di-rewrite oleh
# Worker (src/index.js) DAN raw .html path. Karena Worker rewrite
# `/dashboard` → `/index.html` INTERNAL tapi client hit `/dashboard`,
# _headers matches by URL client-side. Kalau cuma `/index.html`, request
# ke `/dashboard` skip rule ini.
/
  Cache-Control: no-cache, must-revalidate

/dashboard
  Cache-Control: no-cache, must-revalidate

/admin
  Cache-Control: no-cache, must-revalidate

/billing
  Cache-Control: no-cache, must-revalidate

/login
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/admin.html
  Cache-Control: no-cache, must-revalidate

/billing.html
  Cache-Control: no-cache, must-revalidate

/login.html
  Cache-Control: no-cache, must-revalidate

# Service worker — sama, HARUS re-validate biar SW version bump ke-detect.
/sw.js
  Cache-Control: no-cache, must-revalidate

# Static JS shell (broker-codes, panduan, pwa-install, tracker-stats) —
# gak bisa di-hash-versioned (di-import langsung dari HTML tanpa ?v=),
# jadi force revalidate juga.
/broker-codes.js
  Cache-Control: no-cache, must-revalidate

/panduan.js
  Cache-Control: no-cache, must-revalidate

/pwa-install.js
  Cache-Control: no-cache, must-revalidate

/tracker-stats.js
  Cache-Control: no-cache, must-revalidate

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
