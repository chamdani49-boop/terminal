# Untuk dev lokal: salin file ini menjadi .env, lalu jalankan:
#   set -a && source .env && set +a && npm run refresh
#
# Untuk production: set sebagai GitHub Repository Secrets di
#   github.com/chamdani49-boop/terminal/settings/secrets/actions

HISTORY_SHEET_ID=
HISTORY_GID=0

CONSENSUS_SHEET_ID=
CONSENSUS_GID=0

# Optional — sheet realtime (3 kolom: Ticker | Harga Live | % Live).
# Kalau di-set, harga live + % live di sheet ini akan overwrite stats.current
# & stats.mom semua kartu di dashboard tiap kali workflow refresh jalan.
# Kosongin kalau belum siap — dashboard tetap jalan dengan data history bulanan.
LIVE_SHEET_ID=
LIVE_GID=0

# Optional — sheet metadata emiten (kolom: Kode | Nama | Sektor | Papan).
# Dipakai untuk nama & sektor saham di dashboard (search, ticker, overview),
# terutama emiten BARU yang belum ada di lib/static.json. Hanya dibaca saat
# build mode full/history. Prioritas nama/sektor:
#   Meta Sheet > kolom Nama/Sektor di Live Sheet > lib/static.json > kode ticker.
# Header yang dikenali: Kode/Ticker/Symbol/Saham/Code, Nama/Name/Emiten,
# Sektor/Sector/Industry, Papan/Board.
META_SHEET_ID=
META_GID=0
