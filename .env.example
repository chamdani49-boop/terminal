# Salin file ini menjadi .env.local untuk dev lokal,
# atau set sebagai Environment Variables di dashboard Vercel.

# ─────────────────────────────────────────────
# Google Sheet: HISTORI HARGA
# ─────────────────────────────────────────────
# ID spreadsheet ada di URL: docs.google.com/spreadsheets/d/<INI_ID-NYA>/edit#gid=...
HISTORY_SHEET_ID=
# gid tab/sheet di dalam spreadsheet (angka di belakang #gid= pada URL)
HISTORY_GID=0

# ─────────────────────────────────────────────
# Google Sheet: KONSENSUS / REKOMENDASI ANALIS
# ─────────────────────────────────────────────
CONSENSUS_SHEET_ID=
CONSENSUS_GID=0

# ─────────────────────────────────────────────
# (Opsional) cache di edge Vercel, dalam detik
# ─────────────────────────────────────────────
CACHE_SECONDS=300
